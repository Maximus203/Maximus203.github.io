RewriteEngine On

# Redirect root to French (301 permanent — passes link equity to /fr/)
RewriteRule ^$ /fr/ [R=301,L]

# Serve index.html for clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# Cache immutable build assets, while keeping HTML revalidatable.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|jpeg|png|svg|gif|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Next.js injects page-specific inline scripts, requiring 'unsafe-inline' without application server nonces
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://maximus203.github.io 'unsafe-inline'; style-src 'self' https://maximus203.github.io 'unsafe-inline'; img-src 'self' https://maximus203.github.io data:; font-src 'self' https://maximus203.github.io data:; media-src 'self' https://maximus203.github.io; connect-src 'self' https://maximus203.github.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
